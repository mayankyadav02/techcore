NODE_ENV=development

# MongoDB connection string. Required in production.
MONGODB_URI=mongodb://127.0.0.1:27017/techcore

# Session hashing pepper. Required in production (minimum 32 characters).
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=

# Public origin for canonical URLs, sitemap, Open Graph, and CSRF origin checks.
# Required in production. Local default is http://localhost:3000 if unset.
APP_URL=http://localhost:3000

# Resend transactional email configuration (server-only).
# EMAIL_FROM must use a sender address belonging to a domain verified in Resend for production.
# Do not put secrets in the repository.
RESEND_API_KEY=
EMAIL_FROM="TechCore <noreply@yourdomain.com>"
# ADMIN_EMAIL is only a fallback/admin recipient where applicable.
# Settings.contactEmail remains the CMS-configured primary admin recipient.
ADMIN_EMAIL="admin@yourdomain.com"
# Used only by `npm run seed:admin`. Do not commit real credentials.
ADMIN_PASSWORD=
ADMIN_NAME=TechCore Admin
